+json common_chat_no_action_tool_parse(const std::string & definition) {
+    auto tool = json::parse(definition);
+    auto parsed = common_chat_tools_parse_oaicompat(json::array({tool}));
+    const auto & function = tool.at("function");
+    const auto & schema = function.at("parameters");
+    if (parsed.at(0).name.empty() || !function.at("description").is_string() ||
+        schema.value("type", "") != "object" || !schema.contains("properties") ||
+        !schema.at("properties").contains("message") ||
+        schema.at("properties").at("message").value("type", "") != "string" ||
+        !schema.contains("required") || !schema.at("required").is_array() ||
+        std::find(schema.at("required").begin(), schema.at("required").end(), "message") == schema.at("required").end()) {
+        throw std::invalid_argument("no-action tool must define a nonempty name, description and required message:string");
+    }
+    return tool;
+}

