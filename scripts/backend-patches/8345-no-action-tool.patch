+static std::runtime_error common_chat_protocol_error(const std::string & reason, const std::string & raw) {
+    static const char hex[] = "0123456789abcdef";
+    std::string evidence = reason + "; raw bytes (hex): ";
+    for (unsigned char byte : raw) {
+        evidence += hex[byte >> 4];
+        evidence += hex[byte & 15];
+    }
+    // Hex retains every byte, including NUL and invalid UTF-8. The JSON text is for inspection.
+    evidence += "\nraw text (JSON): " + json(raw).dump_safe();
+    return std::runtime_error(evidence);
