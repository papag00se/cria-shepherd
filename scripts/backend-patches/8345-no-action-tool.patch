+json common_chat_no_action_tool_parse(const std::string & definition) {
+    auto tool = json::parse(definition);
+    auto parsed = common_chat_tools_parse_oaicompat(json::array({tool}));
+    const auto & function = tool.at("function");
+    const auto & schema = function.at("parameters");
+    auto allowed_keys = [](const json & object, const std::vector<std::string> & keys) {
+        if (!object.is_object()) { return false; }
+        for (const auto & item : object.items()) {
+            if (std::find(keys.begin(), keys.end(), item.key()) == keys.end()) { return false; }
+        }
+        return true;
+    };
+    if (parsed.at(0).name.empty() || !function.at("description").is_string() ||
+        !allowed_keys(schema, {"type", "properties", "required", "additionalProperties", "description", "title"}) ||
+        schema.value("type", "") != "object" || !schema.contains("properties") ||
+        !schema.at("properties").is_object() || schema.at("properties").size() != 1 ||
+        !schema.at("properties").contains("message") ||
+        !allowed_keys(schema.at("properties").at("message"), {"type", "description", "title"}) ||
+        schema.at("properties").at("message").value("type", "") != "string" ||
+        !schema.contains("required") || !schema.at("required").is_array() ||
+        schema.at("required").size() != 1 || schema.at("required").at(0) != "message" ||
+        (schema.contains("additionalProperties") && schema.at("additionalProperties") != false)) {
+        throw std::invalid_argument("no-action tool requires exactly one plain message:string property, required message and no additional properties or unsupported schema facets");
+    }
+    return tool;
+}

