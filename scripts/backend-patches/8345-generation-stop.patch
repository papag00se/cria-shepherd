+static std::string stop_cause_to_str(server_stop_cause cause) {
+    switch (cause) {
+        case STOP_CAUSE_EOS: return "eos";
+        case STOP_CAUSE_WORD: return "word";
+        case STOP_CAUSE_CONTEXT_CAPACITY: return "context_capacity";
+        case STOP_CAUSE_OUTPUT_BUDGET: return "output_budget";
+        case STOP_CAUSE_TIME: return "time";
+        case STOP_CAUSE_INDENTATION: return "indentation";
+        default: return "unknown";
+    }
+}
+
+server_stop_cause server_stop_cause_from_string(const std::string & cause) {
+    for (auto value : {STOP_CAUSE_EOS, STOP_CAUSE_WORD, STOP_CAUSE_CONTEXT_CAPACITY,
+                       STOP_CAUSE_OUTPUT_BUDGET, STOP_CAUSE_TIME, STOP_CAUSE_INDENTATION}) {
+        if (cause == stop_cause_to_str(value)) { return value; }
+    }
+    return STOP_CAUSE_UNKNOWN;
+}
+
+static std::string protocol_hex(const std::string & raw) {
+    static const char hex[] = "0123456789abcdef";
+    std::string bytes;
+    for (unsigned char byte : raw) { bytes += hex[byte >> 4]; bytes += hex[byte & 15]; }
+    return bytes;
+}
+
+void server_task_result_cmpl_final::update(task_result_state & state) {
+    is_updated = true;
+    oai_resp_id = state.oai_resp_id;
+    oai_resp_reasoning_id = state.oai_resp_reasoning_id;
+    oai_resp_message_id = state.oai_resp_message_id;
+    if (state.chat_parser_params.no_action_tool_name.empty()) {
+        oaicompat_msg = state.update_chat_msg(content, false, oaicompat_msg_diffs);
+        return;
+    }
+    const std::string input = protocol_input.value_or(state.generated_text + content);
+    has_parsed_message = true;
+    generation_evidence = {{"stop_type", stop_type_to_str(stop)}, {"stop_cause", stop_cause_to_str(stop_cause)},
+                           {"context_shifted", context_shifted}, {"truncated", truncated},
+                           {"content_is_non_action", true}};
+    try {
+        if (stop == STOP_TYPE_LIMIT) {
+            generation_evidence["raw_hex"] = protocol_hex(raw_generated_text.empty() ? input : raw_generated_text);
+            generation_evidence["parser_input_hex"] = protocol_hex(input);
+            auto parsed = common_chat_parse(input, true, state.chat_parser_params);
+            auto prefixes = json::array();
+            for (const auto & call : parsed.tool_calls) {
+                prefixes.push_back({{"name", call.name}, {"arguments", call.arguments},
+                                    {"arguments_hex", protocol_hex(call.arguments)}});
+            }
+            generation_evidence["call_prefixes"] = prefixes;
+            generation_evidence["incomplete"] = true;
+            message_withheld = true;
+            if (stream) {
+                // The final event cannot revise a prefix already published by partial results.
+                oaicompat_msg = state.chat_msg;
+                oaicompat_msg_diffs.clear();
+            } else {
+                parsed.role = "assistant";
+                parsed.tool_calls.clear();
+                oaicompat_msg = parsed;
+            }
+        } else {
+            if (input.compare(0, state.generated_text.size(), state.generated_text) != 0) {
+                throw common_chat_protocol_error("Published prefix differs from final parser input", input,
+                                                "Published prefix differs from final parser input");
+            }
+            oaicompat_msg = state.update_chat_msg(input.substr(state.generated_text.size()), false, oaicompat_msg_diffs);
+        }
+    } catch (common_chat_protocol_error & error) {
+        generation_evidence["raw_hex"] = protocol_hex(raw_generated_text.empty() ? input : raw_generated_text);
+        generation_evidence["parser_input_hex"] = protocol_hex(input);
+        error.generation_evidence = generation_evidence;
+        throw;
+    }
+}
