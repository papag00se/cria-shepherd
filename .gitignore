__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# operator/local config (the .example is tracked instead)
cria.toml

# cria runtime state
.cria/
logs/
cria.out

# harness-generated cache
.codex-multi/
docs/audits/2026*

# Dated audit and walk reports. Written during an investigation, read once, and superseded by
# the next one — they are working notes, not the project's documentation. Kept on disk, out of
# git (operator, 2026-08-13). The durable write-ups live in docs/ under stable names.
docs/audits/202*.md

# Per-run harness logs. One file per suite run, 335 of them at 151 MB and growing with every
# arm. They are raw evidence for one run, kept on disk and archived under ~/.cria/suite —
# not something anyone reads out of the repo (operator, 2026-08-13).
# suite/results/results.jsonl IS tracked: it is the scoreboard, not a log.
suite/results/*.log

# Suite run workspaces. A run's workspace IS its evidence, and /tmp is swept on this box —
# one cleaner took a workspace mid-run and the row landed 0/0 with nothing to explain it.
/runs/
